        3100,
        -620
      ],
      "parameters": {
        "jsCode": "const ctx=$('Read registration result').first().json;const raw=typeof $json.text==='string'?$json.text.trim().slice(0,350):'';const allowed=new Set((ctx.product.title+' new condition a an the is in product').toLowerCase().match(/[a-z0-9]+/g)||[]);const words=raw.toLowerCase().match(/[a-z0-9]+/g)||[];const safe=words.length>0&&words.every(w=>allowed.has(w))&&!/[\u20ac$\u00a3]|\\b(price|priced|cost|usd|eur|improved|upgraded)\\b/i.test(raw);const summary=safe?raw:ctx.product.title;return [{json:{...ctx,reply:(ctx.product.is_demo?'[DEMO - simulated product and prices]\\n':'')+'Saved watch #'+ctx.watch.id+': '+ctx.product.title+'\\nTarget: '+(ctx.target_cents/100).toFixed(2)+' EUR; significant drop: '+(ctx.discount_bps/100)+'%.\\nCurrent item price: '+(ctx.product.price_cents/100).toFixed(2)+' EUR.\\nDaily checks: 09:00 Europe/Paris.\\n'+summary+'\\n'+ctx.url}}];"
