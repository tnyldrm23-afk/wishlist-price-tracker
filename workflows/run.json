{
  "id": "wtRunChecks00001",
  "name": "Wishlist | Check Wishlist",
  "active": false,
  "nodes": [
    {
      "id": "f6817455-0b5c-4422-a0a5-2bd4c14137c7",
      "name": "Receive input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "13d8a25e-502d-487c-8bb5-08e0a079bcd1",
      "name": "Load active tracked products",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::jsonb || jsonb_build_object('watches',COALESCE(jsonb_agg(to_jsonb(w) ORDER BY w.id),'[]'::jsonb)) AS data FROM tracker.watches w WHERE w.active AND w.chat_id=$1::jsonb->'cfg'->>'allowed_chat_id' AND w.source=$1::jsonb->'cfg'->>'source';",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "wtPostgres000001",
          "name": "Wishlist PostgreSQL"
        }
      }
    },
    {
      "id": "3505b063-3dea-48d3-b9c8-704759615eeb",
      "name": "Read wishlist result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i=>({json:i.json.data}));"
      }
    },
    {
      "id": "f991af4a-fe9b-492e-abba-b148db0f37d8",
      "name": "Are any products tracked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d2b32b25-456e-49fe-839c-b1f9df4afcd0",
              "leftValue": "={{ $json.watches.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f78408a8-9620-4004-a158-91609aacd1a0",
      "name": "Prepare each product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "return $json.watches.map(watch=>({json:{cfg:$json.cfg,watch}}));"
      }
    },
    {
      "id": "9788de1e-487b-4ba0-9dc2-de1f91fc3be9",
      "name": "Check one product price",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "wtCheckWatch0001",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "e6233482-973d-4020-8275-6e199518e8f4",
      "name": "Summarise check results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "jsCode": "const results=$input.all().map(x=>x.json);return [{json:{...$('Receive input').first().json,reply:'Checked '+results.length+' product(s). '+results.filter(x=>x.status==='price-unavailable').length+' unavailable. New qualifying alerts are sent separately.',results}}];"
      }
    },
    {
      "id": "5750634f-f68e-4d79-97b6-5f36f6a3c2c0",
      "name": "Reply that wishlist is empty",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        160
      ],
      "parameters": {
        "jsCode": "return [{json:{...$('Receive input').first().json,reply:'Your wishlist is empty. Add a product with /watch <link> <target EUR> [discount %].',results:[]}}];"
      }
    }
  ],
  "connections": {
