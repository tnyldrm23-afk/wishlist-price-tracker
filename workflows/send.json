      "position": [
        440,
        140
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.reply }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "wtTelegram000001",
          "name": "Wishlist Telegram"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ed0abdbf-8208-4a70-b8e7-31a85faa2351",
      "name": "Delivery result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "jsCode": "const ctx=$('Input').first().json;const message=$json.result??$json;return [{json:{...ctx,delivered:!$json.error&&($json.ok===true||message.message_id!=null),message_id:message.message_id==null?null:String(message.message_id)}}];"
      }
    },
    {
      "id": "18dccd2a-32c5-44a4-b70a-ca982328b31b",
      "name": "Read me 5",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
