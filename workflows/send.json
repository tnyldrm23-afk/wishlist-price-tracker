    {
      "id": "9e890257-d276-4846-919a-424a5a3ce27c",
      "name": "Capture demo message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -120
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "http://price-service:8080/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({chat_id:$json.chat_id,text:$json.reply,delivery_key:$json.delivery_key}) }}",
        "options": {
          "timeout": 70000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "wtDemoApi0000001",
          "name": "Wishlist internal API"
        }
